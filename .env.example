# Copy to .env next to docker-compose.yml and fill in real values.
# Never commit .env.

# Database
DOCKER_DB_PASSWORD=change-me

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCKER_JWT_SECRET_KEY=change-me

# OpenAI (server-side only; never exposed to the browser)
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4.1-mini

# Production only
API_DOMAIN=api.example.com
CORS_ORIGINS=https://your-project.pages.dev
ENABLE_DOCS=false

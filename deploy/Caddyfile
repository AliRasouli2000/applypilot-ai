# Caddy automatically obtains an HTTPS certificate for API_DOMAIN
# and redirects HTTP to HTTPS.
{$API_DOMAIN} {
	# Reject oversized requests before they reach the API
	request_body {
		max_size 1MB
	}

	reverse_proxy backend:8000 {
		# While the backend container restarts during a deploy,
		# hold requests and retry instead of returning an error.
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
